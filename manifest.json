{
  "manifest_version": 3,
  "name": "Job Copilot BOSS 助手",
  "version": "1.0.0",
  "description": "在真实 BOSS 直聘页面内扫描岗位、AI 匹配简历，并在职位页完成达标岗位沟通。",
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "debugger"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Job Copilot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "page-navigation-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.zhipin.com/*"
      ],
      "js": [
        "content-job-scan.js",
        "content-panel-layout.js",
        "content-state.js",
        "content-manual-contact.js",
        "content-panel.js",
        "content-session.js",
        "content-controls.js",
        "content-analysis.js",
        "content-pipeline.js",
        "content-auto-contact.js",
        "content-page-context.js",
        "content-job-list.js",
        "content-ai-feedback.js",
        "content-contact.js",
        "content-contact-evidence.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
